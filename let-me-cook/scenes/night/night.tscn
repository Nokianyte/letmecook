[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/night/night.gd" id="1_night"]
[ext_resource type="Script" path="res://ui/counter_row.gd" id="2_counter"]

[node name="Night" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_night")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.11, 0.12, 0.16, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TopBar" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 32

[node name="TitleLabel" type="Label" parent="Margin/VBox/TopBar"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Night 1"

[node name="MoneyLabel" type="Label" parent="Margin/VBox/TopBar"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "$0"

[node name="NextRentLabel" type="Label" parent="Margin/VBox/TopBar"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Tomorrow's rent: $0"

[node name="Spacer" type="Control" parent="Margin/VBox/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="OpenButton" type="Button" parent="Margin/VBox/TopBar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(240, 36)
layout_mode = 2
text = "Open the kitchen"

[node name="SummaryLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
modulate = Color(1, 1, 1, 0.75)
text = "Day 1: 0 pts, rent $0 paid."

[node name="Main" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="Market" type="PanelContainer" parent="Margin/VBox/Main"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Scroll" type="ScrollContainer" parent="Margin/VBox/Main/Market"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="VBox" type="VBoxContainer" parent="Margin/VBox/Main/Market/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="MarketHeader" type="HBoxContainer" parent="Margin/VBox/Main/Market/Scroll/VBox"]
layout_mode = 2

[node name="MarketTitle" type="Label" parent="Margin/VBox/Main/Market/Scroll/VBox/MarketHeader"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 18
text = "Market"

[node name="RerollButton" type="Button" parent="Margin/VBox/Main/Market/Scroll/VBox/MarketHeader"]
unique_name_in_owner = true
custom_minimum_size = Vector2(140, 32)
layout_mode = 2
text = "Reroll $1"

[node name="Stock" type="HFlowContainer" parent="Margin/VBox/Main/Market/Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="GadgetsTitle" type="Label" parent="Margin/VBox/Main/Market/Scroll/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Kitchen Gadgets"

[node name="GadgetOffers" type="HFlowContainer" parent="Margin/VBox/Main/Market/Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="SmoothieTitle" type="Label" parent="Margin/VBox/Main/Market/Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Smoothie bar"

[node name="SmoothieStock" type="HFlowContainer" parent="Margin/VBox/Main/Market/Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="StaplesTitle" type="Label" parent="Margin/VBox/Main/Market/Scroll/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Staples (restocked every night)"

[node name="Staples" type="HFlowContainer" parent="Margin/VBox/Main/Market/Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="ToolsTitle" type="Label" parent="Margin/VBox/Main/Market/Scroll/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Tools"

[node name="Tools" type="HFlowContainer" parent="Margin/VBox/Main/Market/Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="Storage" type="PanelContainer" parent="Margin/VBox/Main"]
custom_minimum_size = Vector2(440, 0)
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="Margin/VBox/Main/Storage"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="VBox" type="VBoxContainer" parent="Margin/VBox/Main/Storage/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="CounterTitle" type="Label" parent="Margin/VBox/Main/Storage/Scroll/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Gadgets (drag to reorder; they apply left to right)"
autowrap_mode = 3

[node name="CounterRow" type="HFlowContainer" parent="Margin/VBox/Main/Storage/Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8
script = ExtResource("2_counter")
sellable = true

[node name="FridgeTitle" type="Label" parent="Margin/VBox/Main/Storage/Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Fridge 0/3"

[node name="Fridge" type="HFlowContainer" parent="Margin/VBox/Main/Storage/Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 6

[node name="PantryTitle" type="Label" parent="Margin/VBox/Main/Storage/Scroll/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Pantry (click to move into the fridge)"

[node name="PantryUnits" type="HFlowContainer" parent="Margin/VBox/Main/Storage/Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 6
