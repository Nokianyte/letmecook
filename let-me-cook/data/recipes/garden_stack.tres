[gd_resource type="Resource" script_class="Recipe" format=3]

[ext_resource type="Script" path="res://rules/recipe.gd" id="1_recipe"]

[resource]
script = ExtResource("1_recipe")
display_name = "Garden Stack"
station = 0
match_mode = 2
ingredients = Array[StringName]([&"lettuce", &"tomato", &"onion"])
mult_bonus = 1.5
example = Array[StringName]([&"bun", &"patty", &"lettuce", &"tomato", &"onion", &"bun"])
